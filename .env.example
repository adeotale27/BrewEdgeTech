# Local MongoDB (install MongoDB Community locally or use a MongoDB Atlas URI).
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=brew_edgetech

# Public canonical origin used by the admin SEO audit.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated, exact browser origins. Never use * because the API uses
# credentialed requests. Add only origins you control.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://brewedgetech.com,https://www.brewedgetech.com

# Choose your own local credentials; use long, unique production values.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me-to-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional: set only when your trusted reverse proxy overwrites this header
# with the actual client IP. Leave unset otherwise; login attempts are limited
# by the admin account instead of trusting a caller-supplied forwarding header.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip

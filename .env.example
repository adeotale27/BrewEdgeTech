# Local development template. Copy to .env.local and replace the placeholders.
# Never use these placeholder values in production.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=brew_edgetech
# Optional Atlas SRV fallback if Node cannot resolve mongodb+srv records.
# MONGO_SEED_HOSTS=host1.example.mongodb.net:27017,host2.example.mongodb.net:27017
# MONGO_REPLICA_SET=atlas-replica-set-name

NEXT_PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

ADMIN_USERNAME=local-admin
ADMIN_PASSWORD=replace-this-local-password
ADMIN_SESSION_SECRET=replace-this-with-a-long-random-secret
